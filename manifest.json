{
	"manifest_version": 3,
	"name": "Random Dog Hider",
	"version": "1.0",
	"description": "Hides a dog picture in a random tab.",
	"action": {
	  "default_popup": "popup.html"
	},
	"permissions": [
	  "tabs",
	  "activeTab",
	  "scripting"
	],
	"host_permissions": [
	  "<all_urls>"
	],
	"web_accessible_resources": [
	  {
		"resources": [
		  "dog.png"
		],
		"matches": [
		  "https://*/*",
		  "http://*/*"
		]
	  }
	]
  }
  